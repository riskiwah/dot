# Gruvbox dark. Recolor is a toggle (c), not default: it inverts images/diagrams too.

# 11 not 10: Xft.dpi is 96 but the laptop panel is ~162 DPI, so 10pt renders ~2mm tall.
set font "JetBrainsMono Nerd Font 11"

set default-bg                "#282828"
set default-fg                "#ebdbb2"

set statusbar-bg              "#3c3836"
set statusbar-fg              "#ebdbb2"
set inputbar-bg               "#282828"
set inputbar-fg               "#ebdbb2"
set notification-bg           "#282828"
set notification-fg           "#ebdbb2"
set notification-error-bg     "#282828"
set notification-error-fg     "#fb4934"
set notification-warning-bg   "#282828"
set notification-warning-fg   "#fabd2f"

set completion-bg             "#3c3836"
set completion-fg             "#ebdbb2"
set completion-group-bg       "#282828"
set completion-group-fg       "#928374"
set completion-highlight-bg   "#83a598"
set completion-highlight-fg   "#282828"

# Alpha matters: selection/search are painted over the text, so an opaque color hides it.
set highlight-color           "rgba(250,189,47,0.30)"
set highlight-active-color    "rgba(254,128,25,0.45)"
set highlight-fg              "#fabd2f"

# Used when recolor is on (press r). keephue avoids garish inverted images.
set recolor-darkcolor         "#ebdbb2"
set recolor-lightcolor        "#282828"
set recolor-keephue           true
set recolor-reverse-video     true

# Reading experience
# Width, not best-fit: best-fit shrinks a full page into the 1080px-tall external monitor.
# Layout doesn't follow the monitor; switch with a (whole page), s (width), d / D (dual).
# Only applies to files never opened before: history restores each file's last fit mode.
set adjust-open               width
set page-v-padding            4
set page-h-padding            4
set scroll-page-aware         true
set scroll-step               80
# Keep a sliver of the previous screen on page-down so the reading line isn't lost.
set scroll-full-overlap       0.05
set zoom-step                 10
set selection-clipboard       clipboard
set statusbar-home-tilde      true
set statusbar-page-percent    true
set window-title-basename     true
set window-title-page         true
set guioptions                sv

map r reload
map R rotate
map c recolor
map d toggle_page_mode
# Book spread: cover alone on the right, then facing pages. Saved per file in history.
map D feedkeys ":set first-page-column 1:2<Return>:set pages-per-row 2<Return>"
map J navigate next
map K navigate previous
