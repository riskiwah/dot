{
  "agent": {
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "model": "claude-sonnet-4-6-latest",
      "provider": "anthropic"
    },
    "dock": "right",
    "favorite_models": [],
    "inline_assistant_model": {
      "model": "claude-haiku-4.5",
      "provider": "copilot_chat"
    },
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 15.0,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "context_servers": {
    "lean-ctx": {
      "command": "/usr/bin/lean-ctx",
      "env": {}
    }
  },
  "cursor_shape": "block",
  "disable_ai": false,
  "edit_predictions": {
    "provider": "zed"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules"
  ],
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/host_vars/*.yml",
      "**/host_vars/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml"
    ],
    "Dockerfile": [
      "Dockerfile",
      "Dockerfile.*"
    ],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/Chart.yaml",
      "**/values.yaml",
      "**/values*.yaml",
      "**/values*.yml",
      "**/helmfile*.yaml"
    ],
    "JSON": [
      "json",
      "jsonc",
      "*.code-snippets"
    ],
    "Jinja2": [
      "*.j2"
    ],
    "Make": [
      "Makefile"
    ],
    "env": [
      ".env",
      ".env.*"
    ]
  },
  "git_panel": {
    "dock": "right"
  },
  "gutter": {
    "min_line_number_digits": 2
  },
  "hard_tabs": false,
  "icon_theme": "Zed (Default)",
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true
  },
  "languages": {
    "Go": {
      "code_actions_on_format": {
        "source.organizeImports": true
      },
      "hard_tabs": true,
      "tab_size": 4
    },
    "JSON": {
      "format_on_save": "off",
      "tab_size": 2
    },
    "Make": {
      "hard_tabs": true
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "Plain Text": {
      "soft_wrap": "preferred_line_length"
    },
    "YAML": {
      "formatter": "language_server",
      "hard_tabs": false,
      "tab_size": 2
    }
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "completion": true,
          "hover": true,
          "schemaStore": {
            "enable": true,
            "url": "https://www.schemastore.org/api/json/catalog.json"
          },
          "schemas": {
            "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/inventory.json": [
              "./inventory/*.yaml",
              "hosts.yml"
            ],
            "kubernetes": [
              "**/*deployment*.yaml",
              "**/*deployment*.yml",
              "**/*service*.yaml",
              "**/*service*.yml"
            ]
          },
          "validate": true
        }
      }
    }
  },
  "on_last_window_closed": "quit_app",
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "scrollbar": {
    "show": "never"
  },
  "tab_size": 2,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "theme": "Gruvbox Dark Hard",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "always"
  },
  "vim_mode": true,
  "when_closing_with_no_tabs": "close_window"
}